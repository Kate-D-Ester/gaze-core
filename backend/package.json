{
  "name": "backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --target=bun src/index.ts --outdir dist",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "bun test"
  },
  "dependencies": {
    "@better-auth/api-key": "1.6.33",
    "@elysiajs/cors": "1.4.1",
    "@elysiajs/swagger": "1.3.1",
    "better-auth": "1.6.33",
    "drizzle-orm": "0.45.3",
    "elysia": "1.4.29",
    "postgres": "3.4.8",
    "resend": "6.32.0"
  },
  "devDependencies": {
    "bun-types": "1.3.11",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  },
  "module": "src/index.ts",
  "overrides": {
    "defu": "6.1.7",
    "nanoid": "5.1.16",
    "esbuild": "0.25.12"
  }
}
