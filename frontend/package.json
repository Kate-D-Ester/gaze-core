{
  "name": "frontend",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "bun run --cwd apps/web build",
    "dev": "bun run --cwd apps/web dev",
    "start": "bun run --cwd apps/web start",
    "preview": "bun run --cwd apps/web preview",
    "lint": "bun run --cwd packages/ui lint && bun run --cwd apps/web lint",
    "format": "bun run --cwd packages/ui format && bun run --cwd apps/web format",
    "typecheck": "bun run --cwd packages/ui typecheck && bun run --cwd apps/web typecheck",
    "test": "bun test"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.1.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "js-yaml": "4.3.2",
    "brace-expansion": "5.0.12",
    "defu": "6.1.7",
    "@babel/core": "7.29.7",
    "@humanfs/node": "0.16.8",
    "baseline-browser-mapping": "2.11.27",
    "picomatch": "4.0.7",
    "browserslist": "4.29.3"
  }
}
